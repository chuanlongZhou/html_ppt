{
  "name": "html-ppt",
  "private": true,
  "version": "0.1.0",
  "description": "AI-native web presentation: deck.yaml -> Reveal.js, with screenshots and QA for coding agents",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "new": "tsx engine/src/cli.ts new",
    "build": "tsx engine/src/cli.ts build",
    "check": "tsx engine/src/cli.ts check",
    "export": "tsx engine/src/cli.ts export",
    "dev": "tsx watch --clear-screen=false engine/src/cli.ts dev",
    "gallery": "tsx engine/src/cli.ts gallery",
    "catalog": "tsx engine/src/cli.ts catalog",
    "agents:sync": "tsx engine/src/cli.ts agents-sync",
    "typecheck": "tsc --noEmit -p engine/tsconfig.json"
  },
  "dependencies": {
    "playwright-core": "1.63.0",
    "reveal.js": "6.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
